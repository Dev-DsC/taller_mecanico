# Copia este archivo a Backend/.env y rellena los valores. Backend/.env NO se sube a git.
# En producción (Render) estas mismas claves van en Environment → Environment Variables.
# Qué es cada una y cómo rotarla: docs/plan/06-operacion.md

# Puerto HTTP del API (Render lo inyecta solo)
PORT=3000

# Cadena de conexión de PostgreSQL (db.js exige SSL)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/base

# Firma de los JWT de sesión.
# Genera una larga y aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
